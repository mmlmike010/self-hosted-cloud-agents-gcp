# cp terraform.tfvars.example terraform.tfvars (terraform.tfvars is gitignored)
project_id            = "PROJECT_ID"
region                = "us-east4"
zone                  = "us-east4-a"
worker_repository_url = "https://github.com/OWNER/REPO.git"
worker_image_tag      = "v1"
worker_pool_name      = "gce-lab"

# Set after step 4 of gce/terraform/README.md, or leave empty to skip the first-boot clone
git_token_secret_id = ""
