# Copy to .env and fill in. The Makefile loads .env, and values in .env win
# over the same variables exported in your shell.

# ---------------------------------------------------------------------------
# Cursor self-hosted worker identity
# ---------------------------------------------------------------------------

# Must be a Cursor service account API key. Personal, user, team, and
# organization keys do not work for pool workers. Prefer pasting it into the
# shell so it never lands in a file:
#   read -rs CURSOR_API_KEY && export CURSOR_API_KEY
# Leave this commented out unless you want it in .env. An empty value here
# would override the key exported in your shell.
# CURSOR_API_KEY=

# ---------------------------------------------------------------------------
# GCP shared defaults (both paths)
# ---------------------------------------------------------------------------

PROJECT_ID=PROJECT_ID
REGION=us-east4
ZONE=us-east4-a
AR_REPO=cursor-workers
SECRET_ID=cursor-worker-api-key
TAG=v1

# linux/amd64 for E2 and N2 machine types, linux/arm64 for T2A and C4A.
WORKER_PLATFORM=linux/amd64

# ---------------------------------------------------------------------------
# Path A: Compute Engine + Docker
# ---------------------------------------------------------------------------

# HTTPS clone URL of the repository the repo-bound worker serves.
WORKER_REPOSITORY_URL=https://github.com/OWNER/REPO.git

# Secret Manager secret with a read-only Git token (gce/terraform/README.md,
# step 3). Leave empty to skip the first-boot clone.
GIT_TOKEN_SECRET_ID=cursor-git-read-token

# ---------------------------------------------------------------------------
# Path B: GKE Standard + k8s-workers Helm chart
# ---------------------------------------------------------------------------

GKE_CLUSTER=cursor-workers
K8S_NAMESPACE=cursord
HELM_RELEASE=gke-workers

# ---------------------------------------------------------------------------
# Local Docker run (make docker-build docker-run)
# ---------------------------------------------------------------------------

WORKER_IMAGE=cursor-self-hosted-worker:local
CURSOR_WORKER_POOL_NAME=lab
CURSOR_WORKER_IDLE_RELEASE_TIMEOUT=600
