# cp .env.example .env   (.env is gitignored)
# Read by the Makefile and gke/scripts. Plain KEY=value lines, no quotes.
# Keep CURSOR_API_KEY out of this file. Paste it when a target asks, or export it
# for one shell session with:  read -rs CURSOR_API_KEY && export CURSOR_API_KEY

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
PROJECT_ID=PROJECT_ID
REGION=us-east4
ZONE=us-east4-a
AR_REPO=cursor-workers
IMAGE_NAME=cursor-self-hosted-worker
TAG=v1
# linux/amd64 for E2 and N2, linux/arm64 for Arm types such as T2A and C4A
PLATFORM=linux/amd64
# Secret Manager secret that holds the Cursor service account API key
SECRET_ID=cursor-worker-api-key

# ---------------------------------------------------------------------------
# Compute Engine + Docker
# ---------------------------------------------------------------------------
GCE_NAME=cursor-worker-lab
GCE_POOL=gce-lab
WORKER_REPOSITORY_URL=https://github.com/OWNER/REPO.git
# cursor-git-read-token after `make gce-git-token`, or empty to skip the first-boot clone
GIT_TOKEN_SECRET_ID=
# Principal for `make gce-access`, for example user:you@example.com
ADMIN_MEMBER=

# ---------------------------------------------------------------------------
# GKE + anysphere/k8s-workers
# ---------------------------------------------------------------------------
GKE_CLUSTER=cursor-workers
GKE_MACHINE_TYPE=e2-standard-4
GKE_MIN_NODES=1
GKE_MAX_NODES=5
K8S_NAMESPACE=cursord
K8S_SECRET_NAME=cursor-workers-api-key
HELM_RELEASE=gke-workers
GKE_POOL=gke-workers
CHART_VERSION=0.2.2
# Space-separated overlays from gke/helm/, for example values-clone-git-repos.yaml
VALUES_OVERLAYS=
